# ============================================
# Buddy AI - Environment Configuration
# ============================================
# Copy this file to .env and fill in the values
#   cp .env.example .env
# ============================================

# --- Server ---
PORT=5000
NODE_ENV=development

# --- Database (PostgreSQL 16 + pgvector) ---
DATABASE_URL=postgresql://user:password@localhost:5432/buddy_ai

# --- Session & Auth ---
SESSION_SECRET=your-session-secret-here
JWT_SECRET=your-jwt-secret-here

# --- Google OAuth 2.0 ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Replit OIDC (only needed on Replit) ---
# ISSUER_URL=https://replit.com/oidc
# REPL_ID=

# --- AI: Anthropic (primary, direct API) ---
ANTHROPIC_API_KEY=

# --- AI: Proxy / OpenRouter keys ---
# Used as fallback when ANTHROPIC_API_KEY is not set
CLAUDE_SIMPLE_API_KEY=
CLAUDE_COMPLEX_API_KEY=
AI_API_KEY=
AI_BASE_URL=https://new.pumpkinai.vip/v1

# --- AI: OpenAI (optional, for GPT models) ---
OPENAI_API_KEY=

# --- AI: Tavily Web Search ---
TAVILY_API_KEY=

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=Deltapex_Alex_Bot
VITE_TELEGRAM_BOT_USERNAME=Deltapex_Alex_Bot

# --- Admin ---
# Comma-separated list of admin email addresses
ADMIN_EMAILS=
